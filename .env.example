# ── BASE DE DATOS ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:clave@host:5432/feline

# ── SEGURIDAD ────────────────────────────────────────────────────────────────
# 64 caracteres hex (32 bytes). Cifra certificados .pfx y llaves CAF. Obligatoria en producción.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_VAULT_MASTER_KEY=

# ── SERVIDOR ─────────────────────────────────────────────────────────────────
PORT=3004
# URL pública de Feline: se usa en xmlUrl/pdfUrl que reciben las integraciones (ej. FUGAR)
FELINE_PUBLIC_URL=http://localhost:3004

# ── CONEXIÓN AL SII Y DESPACHADOR ────────────────────────────────────────────
# real     = maullin.sii.cl / palena.sii.cl según el ambiente de cada empresa
# simulado = SII falso que acepta todo (solo desarrollo; prohibido en producción)
FELINE_SII_MODO=simulado
# off desactiva el envío automático al SII y los webhooks
FELINE_DISPATCHER=off
FELINE_DISPATCHER_INTERVAL_MS=15000

# ── ADMINISTRACIÓN Y MODO DEMOSTRACIÓN ───────────────────────────────────────
# Token para crear empresas por API (POST /api/v1/tenants con "Authorization: Bearer <token>").
# Sin él, esa ruta queda deshabilitada (503); el alta sigue disponible con npm run admin.
FELINE_ADMIN_TOKEN=
# El panel de demostración (/api/v1/dashboard/*, datos en memoria con login) se bloquea
# cuando NODE_ENV=production. Solo para una demo pública controlada: FELINE_DEMO=on
FELINE_DEMO=

# ── INICIO DE SESIÓN DEL PANEL ───────────────────────────────────────────────
# Secreto para firmar la sesión (obligatorio en producción). Generar:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FELINE_SESSION_SECRET=
# Contraseña de los usuarios de demostración que aún no tienen una propia.
# Si queda vacía, se genera una temporal en cada inicio y se ofrece solo por el acceso de desarrollo, sin guardarla en registros.
FELINE_PANEL_CLAVE_DEMO=

# Producción SII permanece bloqueada sin autorización expresa del operador.
# No habilitar durante pruebas. Una autorización en chat no configura esta variable.
FELINE_SII_PRODUCCION_AUTORIZADA=

# Libro contable persistente: proceso periódico, desactivado al instalar.
# Además se habilita por empresa desde /finanzas > Contabilidad > Centralización.
FELINE_FINANCE_DISPATCHER=off

# Aprovisionamiento local de un usuario persistente (npm run finance:user).
# Completar temporalmente mediante entorno seguro; no registrar ni versionar contraseñas.
FELINE_FINANCE_TENANT_ID=
FELINE_FINANCE_EMAIL=
FELINE_FINANCE_NAME=
FELINE_FINANCE_PASSWORD=
FELINE_FINANCE_ROLE=VIEWER

# Escucha local de desarrollo; en servidores configurar el host expresamente.
FELINE_HOST=127.0.0.1
# Solo una base vacía y localhost pueden habilitar el primer registro.
# No habilitar en producción ni sobre una base existente.
FELINE_FINANCE_SETUP=
