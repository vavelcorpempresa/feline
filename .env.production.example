# ==============================================================================
# FELINE — VARIABLES DE PRODUCCIÓN (Droplet de DigitalOcean)
# En el Droplet: cp .env.production.example .env.production && chmod 600 .env.production
# Guía completa: docs/DESPLIEGUE.md. Generar secretos con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No pongas comillas en los valores.
# ==============================================================================

NODE_ENV=production

# ── DOMINIO ───────────────────────────────────────────────────────────────────
# Dominio que atiende Caddy con HTTPS automático (sin https://). Debe apuntar al Droplet antes de desplegar.
DOMAIN=feline.tudominio.cl
# URL pública, sin "/" final: va en xmlUrl/pdfUrl y en las variables que reciben los sistemas conectados.
FELINE_PUBLIC_URL=https://feline.tudominio.cl

# ── BASE DE DATOS (DigitalOcean Managed PostgreSQL) ───────────────────────────
# Usa la conexión DIRECTA (puerto 25060), no el pool: las migraciones de Prisma no funcionan por el pool.
#   postgresql://doadmin:<clave>@<host>:25060/feline?sslmode=require
DATABASE_URL=

# ── SECRETOS ──────────────────────────────────────────────────────────────────
# Cifra los certificados .pfx y las llaves CAF dentro de la base. 64 caracteres hex.
# GUÁRDALA FUERA DEL SERVIDOR (gestor de contraseñas). Si se pierde, los certificados y CAF guardados
# quedan ilegibles y hay que volver a cargarlos. Nunca cambiarla después de cargar certificados.
TENANT_VAULT_MASTER_KEY=
# Firma las sesiones del panel. Si cambia, se cierran todas las sesiones.
FELINE_SESSION_SECRET=
# Token de plataforma: alta de empresas y sistemas por API (/v1/plataforma). Largo y aleatorio.
# No se entrega a ningún sistema conectado. Vacío = plataforma deshabilitada (503).
FELINE_ADMIN_TOKEN=

# ── SII ───────────────────────────────────────────────────────────────────────
# real = maullin.sii.cl (empresas en CERTIFICACION) o palena.sii.cl (empresas en PRODUCCION).
FELINE_SII_MODO=real
# Envío al SII de producción (palena): bloqueado hasta que el operador lo autorice escribiendo
# exactamente SI_AUTORIZO_PRODUCCION. Mientras esté vacío, solo funciona la certificación (maullin).
FELINE_SII_PRODUCCION_AUTORIZADA=
# Despachador: envía al SII, consulta estados y entrega webhooks a los sistemas conectados.
FELINE_DISPATCHER=on
FELINE_DISPATCHER_INTERVAL_MS=15000

# ── FINANZAS ──────────────────────────────────────────────────────────────────
# Centralización contable automática (además se habilita por empresa en /finanzas).
FELINE_FINANCE_DISPATCHER=off
# Nunca habilitar en producción
FELINE_FINANCE_SETUP=
FELINE_DEMO=

# ── CORREO (Resend, por API HTTPS: DigitalOcean bloquea SMTP) ────────────────
# Envía el PDF y el XML al receptor cuando el SII acepta el documento (si la emisión trae receptor.correo).
# Clave de Resend con permiso solo de envío para el dominio del remitente. Sin clave, los correos esperan.
RESEND_API_KEY=
# Dirección de un dominio verificado en Resend. El nombre visible es la razón social de cada empresa.
FELINE_CORREO_REMITENTE=documentos@fugar.cl
# Opcional: a dónde llegan las respuestas de los clientes.
FELINE_CORREO_RESPONDER_A=

# ── RESPALDOS (Space privado de DigitalOcean) ─────────────────────────────────
# Spaces → Create a Space (misma región, privado) y API → Spaces Keys (solo ese bucket).
# Puede ser el mismo Space de FUGAR: Feline usa la carpeta feline/.
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
