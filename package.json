{
  "name": "feline",
  "version": "1.4.0",
  "description": "Feline - Sistema Backend Multiempresa (Multitenant) de Facturación Electrónica (DTE) para SII Chile",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc -p tsconfig.json",
    "admin": "tsx --env-file-if-exists=.env src/admin/feline-admin.ts",
    "db:push": "prisma db push",
    "finance:user": "tsx --env-file-if-exists=.env src/admin/finance-user.ts",
    "test:unit": "vitest run --exclude tests/api-v1.integration.test.ts --exclude tests/finance-core.integration.test.ts --exclude tests/finance-setup.integration.test.ts --exclude tests/finance-receivables.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.20.0",
    "bwip-js": "^4.11.4",
    "esbuild": "0.28.2",
    "fastify": "^4.28.1",
    "iconv-lite": "^0.6.3",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.17.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/node-forge": "^1.3.11",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "xml-crypto": "^6.4.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
